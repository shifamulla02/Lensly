{
  "manifest_version": 3,
  "name": "Lensly – Accessibility & Focus Assistant",
  "version": "5.0.0",
  "description": "Accessibility, focus and reading assistant with AI summary, page chatbot, highlights, dark mode, and more.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lensly",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*/*.pdf", "file://*/*.pdf"],
      "js": ["readability.js", "summarizer.js", "chatbot.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-reader-view": {
      "suggested_key": { "default": "Ctrl+Shift+Q", "mac": "Command+Shift+Q" },
      "description": "Toggle Reader View"
    },
    "toggle-focus-mode": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle Focus Mode"
    }
  },
  "web_accessible_resources": [
    { "resources": ["assets/*"], "matches": ["<all_urls>"] }
  ]
}
